{
	"name": "ecli-web",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check build-only",
		"preview": "vite preview",
		"test:unit": "vitest",
		"build-only": "vite build",
		"type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
		"lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
		"format": "prettier --write src/",
		"gen-api": "rm -rf src/api-client && npx @openapitools/openapi-generator-cli generate -i ./spec/apis.yaml -g typescript-axios -o src/api-client"
	},
	"dependencies": {
		"@formkit/icons": "^1.7.2",
		"@formkit/themes": "^1.7.2",
		"@formkit/vue": "^1.7.2",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@yowasp/clang": "22.0.0-git20542-10",
		"bun": "^1.3.5",
		"element-plus": "^2.13.0",
		"pinia": "^3.0.4",
		"sass": "^1.97.1",
		"vite-plugin-comlink": "^5.3.0",
		"vue": "^3.5.26",
		"vue-router": "^4.6.4",
		"vue-upload-component": "next"
	},
	"devDependencies": {
		"@rushstack/eslint-patch": "^1.15.0",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/vite": "^4.1.18",
		"@tsconfig/node18": "^18.2.6",
		"@types/brotli-webpack-plugin": "^1.1.6",
		"@types/emscripten": "^1.41.5",
		"@types/jsdom": "^27.0.0",
		"@types/node": "^25.0.3",
		"@vicons/fluent": "^0.13.0",
		"@vicons/material": "^0.13.0",
		"@vicons/tabler": "^0.13.0",
		"@vitejs/plugin-vue": "^6.0.3",
		"@vitejs/plugin-vue-jsx": "^5.1.3",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.6.0",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.8.1",
		"autoprefixer": "^10.4.23",
		"axios": "^1.13.2",
		"brotli-webpack-plugin": "^1.1.0",
		"codemirror": "^6.0.2",
		"comlink": "^4.4.2",
		"emception": "^1.0.15",
		"eslint": "^9.39.2",
		"eslint-plugin-vue": "^10.6.2",
		"jsdom": "^27.3.0",
		"monaco-editor": "^0.55.1",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"puppeteer-core": "^25.10.0",
		"tailwindcss": "^4.1.18",
		"typescript": "~5.9.3",
		"unplugin-auto-import": "^20.3.0",
		"unplugin-vue-components": "^30.0.0",
		"vfonts": "^0.0.3",
		"vite": "^7.3.0",
		"vite-plugin-compression": "^0.5.1",
		"vitest": "^4.0.16",
		"vue-codemirror": "^6.1.1",
		"vue-tsc": "^3.2.1"
	}
}
